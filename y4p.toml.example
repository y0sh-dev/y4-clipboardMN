# y4p Configuration Reference
#
# y4p loads configuration on startup from:
#   $XDG_CONFIG_HOME/y4p/y4p.toml
#   (falls back to ~/.config/y4p/y4p.toml if XDG_CONFIG_HOME is unset)
#
# If the configuration file is missing or contains syntax errors, y4p
# falls back safely to built-in defaults without crashing or refusing to start.
# All sections and keys are optional. Unrecognised keys are silently ignored.

[general]
# Maximum number of unpinned history entries to retain in SQLite storage.
# When the threshold is exceeded, the oldest unpinned entries are pruned.
# Pinned records are permanently exempt from rotation.
# Can be overridden by the Y4P_MAX_HISTORY environment variable.
# Default: 256
max_history = 256

[mime]
# Drop Rich Text Format (text/rtf, application/rtf) offers at ingress when
# a corresponding plain text offer is already present, preventing bloat.
# Default: true
drop_rtf = true
